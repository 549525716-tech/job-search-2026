  "heading_like_paragraphs_not_heading_style": [
    {
      "para_index": 4,
      "text": "\u56e2\u961f\u7ba1\u7406\uff1a\u540c\u671f\u76f4\u63a5\u7ba1\u740610\u4eba\uff0c\u8986\u76d6\u4e3b\u7ba1\u3001\u4e1a\u52a1\u4e3b\u7ba1\u53ca\u4e00\u7ebf\u9500\u552e\uff1b\u8d1f\u8d23\u62db\u8058\u3001\u7ee9\u6548\u8bc4\u4ef7\u4e0e\u6fc0\u52b1\u5206\u914d\u51b3\u7b56\uff0c\u53c2\u4e0e\u664b\u5347\u63a8\u8350\u3002",
      "style": "Normal"
    },
    {
      "para_index": 5,
      "text": "\u7ba1\u7406\u6210\u679c\uff1a\u4e50\u9053\u56e2\u961f\u5b63\u5ea6\u76ee\u6807\u5b8c\u6210\u7387\u8d85200%\uff0c\u7d2f\u8ba1\u5e26\u655921\u4eba\u3001\u57f9\u517b10\u4eba\u664b\u5347\uff1b\u5f53\u524d\u4e2a\u4eba\u7ecf\u8425210\u5bb6\u5546\u6237\uff0c\u5e76\u627f\u62c5\u5927\u533a\u8de8\u533a\u57df\u76ee\u6807\u62c6\u89e3\u3001\u5206\u5de5\u4e0e\u7763\u529e\u3002",
      "style": "Normal"
    },
    {
      "para_index": 6,
      "text": "\u7ecf\u8425\u63d0\u6548\uff1a\u8bbe\u8ba1\u56e2\u961f\u5168\u5458\u4f7f\u7528\u7684AI\u5ba2\u6237\u5730\u56fe\uff0c\u5c06\u7ecf\u8425\u6570\u636e\u8f6c\u5316\u4e3a\u5546\u6237\u4f18\u5148\u7ea7\u3001\u62dc\u8bbf\u8def\u7ebf\u548c\u884c\u52a8\u5efa\u8bae\uff1b\u4e2a\u4eba\u6d4b\u5f97\u62dc\u8bbf\u6548\u7387\u63d0\u5347150%\uff0c\u6bcf\u5929\u51cf\u5c11\u7ea62\u5c0f\u65f6\u89c4\u5212\u4e0e\u590d\u76d8\u65f6\u95f4\u3002",
      "style": "Normal"
    },
    {
      "para_index": 8,
      "text": "\u76ee\u6807\u4e0e\u7ed3\u679c\u7ba1\u7406\uff1a\u76ee\u6807\u62c6\u89e3\u3001\u8fc7\u7a0b\u6307\u6807\u3001\u7ecf\u8425\u590d\u76d8\u3001\u504f\u5dee\u8bca\u65ad\u4e0e\u6267\u884c\u8ddf\u8e2a",
      "style": "Normal"
    },
    {
      "para_index": 9,
      "text": "\u4eba\u5458\u7ba1\u7406\u4e0e\u57f9\u517b\uff1a\u62db\u8058\u3001\u7ee9\u6548\u8bc4\u4ef7\u3001\u6fc0\u52b1\u5206\u914d\u3001\u5206\u5c42\u5e26\u6559\u4e0e\u664b\u5347\u63a8\u8350\u53c2\u4e0e",
      "style": "Normal"
    },
    {
      "para_index": 10,
      "text": "\u5ba2\u6237\u7ecf\u8425\u4e0e\u7b56\u7565\uff1a\u6c7d\u8f66\u884c\u4e1a\u6d1e\u5bdf\u3001\u5ba2\u6237\u5206\u5c42\u3001\u5546\u4e1a\u6d88\u8017\u3001\u7ebf\u7d22\u6210\u4ea4\u6f0f\u6597\u4e0e\u7ecf\u8425\u65b9\u6848",
      "style": "Normal"
    },
    {
      "para_index": 11,
      "text": "\u8de8\u533a\u57df\u7ecf\u8425\u534f\u540c\uff1a\u8de8\u533a\u57df\u4efb\u52a1\u5206\u5de5\u3001\u540e\u7eed\u7763\u529e\u3001\u5ba2\u6237\u653f\u7b56\u4e0e\u8d44\u6e90\u914d\u7f6e\u5efa\u8bae",
      "style": "Normal"
    },
    {
      "para_index": 12,
      "text": "AI\u7ecf\u8425\u65b9\u6cd5\u590d\u7528\uff1a\u5ba2\u6237\u5730\u56fe\u3001\u8f66\u578b\u5206\u6790\u3001\u8bca\u65ad\u5efa\u8bae\u53ca\u56e2\u961f\u53ef\u5171\u4eab\u5de5\u4f5c\u6d41",
      "style": "Normal"
    },
    {
      "para_index": 15,
      "text": "\u4e2a\u4eba\u5ba2\u6237\u7ecf\u8425\uff5c\u5927\u533a\u8de8\u533a\u57df\u534f\u540c\uff5cAI\u7ecf\u8425\u63d0\u6548\uff5c\u5e7f\u5dde",
      "style": "Normal"
    },
    {
      "para_index": 16,
      "text": "\u4e1a\u7ee9\u7ed3\u679c",
      "style": "Normal"
    },
    {
      "para_index": 21,
