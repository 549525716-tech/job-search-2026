{
  "schema_version": 1,
  "version": "2026-10-18-once-per-contact-task-handoff-v3",
  "intent": "Continuously discover opportunities, create high-quality evidence-bound per-JD resumes and apply once per channel-specific target under accepted scoped authorization.",
  "architecture_ref": "careers/docs/autonomous-headhunter.md",
  "resume_quality_ref": "careers/config/resume-quality-policy.json",
  "runtime": {"enabled": false, "driver_status": "not_implemented_or_accepted", "schedule_enabled": false},
  "authorization": {
    "mode": "explicit_selected_job_batch",
    "future_mode": "bounded_standing_policy_after_driver_acceptance",
    "standing_policy_status": "not_implemented_or_activated",
    "standing_policy_required_scope": ["candidate_id", "roles_and_exclusions", "salary_interpretation", "locations", "permitted_channels", "employer_verification", "allowed_actions", "materials_rules", "daily_send_budget", "contact_templates", "valid_until", "revocation"],
    "bookmark_is_consent": false,
    "required_bindings": ["company_id", "source_job_id", "jd_sha256", "profile_sha256", "recipient_origin", "allowed_actions", "tailoring_scope"],
    "allowed_actions_after_acceptance": ["tailor_from_confirmed_facts", "fill_verified_fields", "upload_named_artifacts", "submit_selected_application", "send_approved_initial_greeting"],
    "tailoring_scope": "Reorder and translate confirmed evidence; no new factual or material claims",
    "one_batch_confirmation_not_each_field": true,
    "reconfirm_on": ["recipient_or_job_change", "jd_material_change", "new_fact", "unapproved_commitment", "salary_or_start_date_unknown", "authorization_revoked"]
  },
  "human_handoff": ["registration", "login", "captcha", "otp", "mfa", "identity_verification", "missing_required_facts", "sensitive_or_legal_declarations"],
  "login_checkpoint": {
    "implementation": "careers/login-checkpoint.mjs",
    "runtime_status": "offline_pure_contract_no_browser_scheduler",
    "pause": "affected_task_and_shared_account_dependencies",
    "preserve_original_page": true,
    "refresh_close_poll_or_takeover_during_handoff": false,
    "other_tasks": "separate_page_only_with_fresh_admission_and_no_source_platform_or_account_halt",
    "resume": "user_completion_then_fresh_admission_then_session_revalidation",
    "unknown_submission_resume": "reconcile_only_never_resend",
    "login_completion_clears_quarantine": false,
    "shared_queue_ref": "careers/web-session.mjs"
  },
  "never_infer": ["work_authorization", "expected_salary", "start_date", "education", "employment_dates", "disability_or_health", "referee_consent", "non_compete_status"],
  "salary_gate": {"target_ref": "careers/config/preferences.json#salary", "unknown_or_crossing_base_requires_explicit_batch_exception": false, "unknown_advertised_salary_requires_policy_decision": true, "range_upper_20k_is_opportunity_not_fixed_base": true, "exception_scope": "Applying does not accept compensation; fixed base remains separately unverified"},
  "privacy": {"plaintext_passwords_in_files": false, "export_all_browser_cookies": false, "upload_unselected_files": false, "optional_sensitive_fields_default": "omit", "resume_receiver": "verified_selected_employer_or_its_authorized_ATS"},
  "excluded_actions": ["pay_fees", "accept_offer", "sign_contract", "resign", "message_unselected_recipients", "bypass_access_controls"],
  "submission": {
    "identity_implementation": "careers/application-identity.mjs",
    "platform_identity": ["candidate", "platform", "verified_employer", "normalized_title", "stable_publisher_id"],
    "official_identity": ["candidate", "verified_employer", "ats_tenant", "native_requisition_id", "verified_contact_or_verified_no_contact", "stable_publisher_id_when_contact"],
    "official_contact_statuses": ["verified_contact", "verified_no_contact", "unknown"],
    "missing_contact_is_verified_no_contact": false,
    "new_contact_is_new_official_target": true,
    "legacy_official_history": "preserve_original_rows_and_receipts; evidence_bound_alias_or_block_for_reconciliation",
    "identity_missing_action": "keep_observation_and_resolve_before_send",
    "display_name_is_stable_publisher_id": false,
    "new_publisher_is_new_platform_target": true,
    "new_jd_salary_city_or_resume_resets_application_history": false,
    "rejected_or_withdrawn_resets_history": false,
    "cross_platform_merge_by_title": false,
    "cold_start_requires_platform_history_reconciliation": true,
    "retry_when_result_unknown": false,
    "persist_unknown_before_external_send": true,
    "success_requires": "Visible confirmation page, application record or receipt identifying the target and uploaded artifact; local hashes alone are not verification",
    "transient_failure_requires_reconciliation": true,
    "shared_account_attachment_lock": true,
    "global_latest_resume_is_upload_selection": false
  },
  "states": ["discovered", "awaiting_assessment", "selected", "authorized", "preparing", "waiting_for_user", "ready_to_submit", "submission_unknown", "submitted_verified", "interview", "rejected", "withdrawn"],
  "quarantined_collection_adapter_may_be_reused": false
}
